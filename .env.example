# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your local MongoDB or MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/homehive

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin default configuration (Created during seeding)
ADMIN_EMAIL=admin@homehive.com
ADMIN_PASSWORD=AdminPassword123

# Optional integrations
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# GOOGLE_MAPS_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
